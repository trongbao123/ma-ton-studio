# Bắt buộc
DATABASE_URL=          # Neon — Vercel tự thêm khi kết nối Storage → Neon
GEMINI_API_KEY=        # free ở https://aistudio.google.com/apikey
ADMIN_USER=            # username vào web (bỏ trống = nhập gì cũng được)
ADMIN_PASSWORD=        # mật khẩu vào web

# Thêm AI (tuỳ chọn) — đặt cả ở Vercel và GitHub Secrets; thứ tự dùng chỉnh ở trang Cài đặt AI
ANTHROPIC_API_KEY=     # Claude — console.anthropic.com
OPENAI_API_KEY=        # ChatGPT — platform.openai.com

# Tuỳ chọn
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview
GEMINI_CHEAP_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-31b-it

# Tự đăng YouTube (xem README) — đặt cả ở Vercel và GitHub Secrets
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
